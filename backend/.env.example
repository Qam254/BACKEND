# Server Configuration
PORT=3000
NODE_ENV=development

# EasyPay Payment Gateway Credentials
EASYPAY_BASE_URL=https://api.easypay.co.tz/v1/payments
EASYPAY_API_KEY=your_easypay_api_key_here
EASYPAY_SECRET_KEY=your_easypay_secret_key_here
EASYPAY_WEBHOOK_SECRET=your_easypay_webhook_secret_here
EASYPAY_DEFAULT_REFERENCE=COL20260109LINK01XYZ

# Beem Africa SMS Gateway Credentials
BEEM_API_KEY=your_beem_api_key_here
BEEM_SECRET_KEY=your_beem_secret_key_here
BEEM_SOURCE_ADDR=INFO
